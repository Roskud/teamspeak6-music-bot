[Unit]
Description=VibeSpeak - TeamSpeak 6 MusicBot (TS3AudioBot with Yandex Music & Radio)
After=network.target network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ts3bot
Group=ts3bot
WorkingDirectory=/opt/ts3audiobot
ExecStart=/opt/ts3audiobot/start.sh
Restart=always
RestartSec=5
KillMode=mixed
Environment=DOTNET_SYSTEM_GLOBALIZATION_INVARIANT=1

# Высокий приоритет аудио-процесса (защита от заикания звука)
Nice=-10
CPUSchedulingPolicy=other
LimitNOFILE=65536

# Безопасность и оптимизация ресурсов
ProtectSystem=full
ProtectHome=true
NoNewPrivileges=true
MemoryMax=1G

[Install]
WantedBy=multi-user.target
